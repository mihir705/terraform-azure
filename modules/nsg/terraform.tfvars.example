# NSG module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/nsg/README.md
#
# Required in terraform.tfvars (once per environment):
#   azure_location = "eastus"
#   default_tags   = { Environment = "prod", ManagedBy = "terraform" }

# ---------------------------------------------------------------------------
# App servers — allow HTTP from VNet
# ---------------------------------------------------------------------------

network_security_groups = {
  app = {
    name               = "my-company-app-prod"
    resource_group_key = "main"
    vnet_key           = "main"
    description        = "Application instance NSG"

    ingress_rules = [
      {
        description            = "HTTP from VNet"
        protocol               = "tcp"
        destination_port_range = "8080"
        source_address_prefix  = "10.0.0.0/16"
      }
    ]

    tags = {
      Purpose = "app"
    }
  }
}

