# Key Vault module — terraform.tfvars example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/key-vault/README.md
#
# Required in terraform.tfvars (once per environment):
#   location     = "eastus"
#   default_tags = { Environment = "prod", ManagedBy = "terraform" }

# ---------------------------------------------------------------------------
# Basic — RBAC-enabled application vault
# ---------------------------------------------------------------------------

key_vaults = {
  app = {
    resource_group_name = "rg-mycompany-app-prod"
    location            = "eastus"
    name                = "kv-mycompany-app-prod"

    enable_rbac_authorization = true
    purge_protection_enabled  = true

    network_acls = {
      default_action = "Deny"
      bypass         = "AzureServices"
      ip_rules       = ["203.0.113.10"]
    }

    tags = {
      Purpose = "application-secrets"
    }
  }
}

