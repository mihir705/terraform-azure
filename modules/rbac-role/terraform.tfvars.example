# RBAC Role module — terraform.tfvars example

rbac_roles = {
  app-identity = {
    name               = "app-identity-prod"
    resource_group_key = "app"
    identity_type      = "user_assigned"

    role_assignments = {
      rg-contributor = {
        scope                = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-mycompany-app-prod"
        role_definition_name = "Contributor"
      }
    }

    tags = {
      Purpose = "app-identity"
    }
  }
}

