# CDN module — terraform.tfvars example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/cdn/README.md
#
# Required in terraform.tfvars (once per environment):
#   azure_location = "eastus"
#   default_tags   = { Environment = "prod", ManagedBy = "terraform" }

# ---------------------------------------------------------------------------
# Basic — CDN with managed origin storage account
# ---------------------------------------------------------------------------

cdn_profiles = {
  static-site = {
    resource_group_name = "my-company-rg-prod"
    location            = "eastus"
    name                = "my-company-cdn-prod"
    endpoint_name       = "static-site"

    origin_storage_account_name = "mycompanystaticprod"

    tags = {
      Purpose = "static-site"
    }
  }
}

