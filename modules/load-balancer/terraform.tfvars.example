# Load Balancer module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/load-balancer/README.md
#
# Required in terraform.tfvars (once per environment):
#   azure_location = "eastus"
#   default_tags   = { Environment = "prod", ManagedBy = "terraform" }
#
# Load balancer requires a VNet. Use vnet_key to auto-wire from the VNet module.

# ---------------------------------------------------------------------------
# Internet-facing load balancer with TCP listener
# ---------------------------------------------------------------------------

load_balancers = {
  public = {
    name               = "my-company-public-lb-prod"
    resource_group_key = "main"
    vnet_key           = "main"

    target_groups = {
      app = {
        port     = 8080
        protocol = "Tcp"
      }
    }

    listeners = {
      tcp = {
        port             = 8080
        protocol         = "Tcp"
        target_group_key = "app"
      }
    }

    tags = {
      Purpose = "public-lb"
    }
  }
}

