# PostgreSQL Flexible Server module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/postgresql-flexible/README.md

# ---------------------------------------------------------------------------
# Private PostgreSQL with VNet integration and private DNS
# ---------------------------------------------------------------------------

postgresql_servers = {
  app = {
    name                = "my-company-pg-prod"
    resource_group_key  = "app"
    sku_name            = "GP_Standard_D2s_v3"
    administrator_login = "pgadmin"
    postgres_version    = "16"
    storage_mb          = 65536

    vnet_key                = "main"
    subnet_key              = "database"
    create_private_dns_zone = true

    databases = {
      app = {}
    }

    configurations = {
      "azure.extensions" = { value = "CITEXT,HSTORE" }
    }

    tags = {
      Purpose = "application-db"
    }
  }
}

