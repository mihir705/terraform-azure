# VNet module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/vnet/README.md
#
# Required in terraform.tfvars (once per environment):
#   azure_location = "eastus"
#   default_tags   = { Environment = "prod", ManagedBy = "terraform" }
#
# Creates: VNet, 2 public + 2 private subnets, route tables,
#          NAT gateway, public/private subnet NSGs.

# ---------------------------------------------------------------------------
# Standard — 2 public + 2 private subnets, single NAT gateway
# ---------------------------------------------------------------------------

vnets = {
  main = {
    name               = "my-company-prod"
    resource_group_key = "main"
    address_space      = ["10.0.0.0/16"]

    public_subnets = {
      az-a = {
        availability_zone = "1"
        address_prefix    = "10.0.1.0/24"
      }
      az-b = {
        availability_zone = "2"
        address_prefix    = "10.0.2.0/24"
      }
    }

    private_subnets = {
      az-a = {
        availability_zone = "1"
        address_prefix    = "10.0.11.0/24"
      }
      az-b = {
        availability_zone = "2"
        address_prefix    = "10.0.12.0/24"
      }
    }

    tags = {
      Purpose = "main-network"
    }
  }
}

