# Resource Group module — terraform.tfvars example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/resource-group/README.md
#
# Required in terraform.tfvars (once per environment):
#   location     = "eastus"
#   default_tags = { Environment = "prod", ManagedBy = "terraform" }

# ---------------------------------------------------------------------------
# Basic — shared application resource group
# ---------------------------------------------------------------------------

resource_groups = {
  app = {
    resource_group_name = "rg-mycompany-app-prod"
    location            = "eastus"

    tags = {
      Purpose = "application"
    }
  }
}

