# Function App module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/function-app/README.md
#
# Required in terraform.tfvars (once per environment):
#   location            = "eastus"
#   resource_group_name = "my-company-rg-prod"
#   default_tags        = { Environment = "prod", ManagedBy = "terraform" }

# ---------------------------------------------------------------------------
# Linux consumption function with zip deployment
# ---------------------------------------------------------------------------

function_apps = {
  api-handler = {
    name                = "my-company-api-prod"
    resource_group_name = "my-company-rg-prod"
    location            = "eastus"
    os_type             = "Linux"
    service_plan_sku    = "Y1"
    runtime_name        = "python"
    runtime_version     = "3.12"
    package_source_dir  = "function-src/api-handler"

    app_settings = {
      ENV = "prod"
    }

    tags = {
      Purpose = "api-handler"
    }
  }
}

