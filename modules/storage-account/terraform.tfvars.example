# Storage Account module — terraform.tfvars example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/storage-account/README.md
#
# Required in terraform.tfvars (once per environment):
#   location     = "eastus"
#   default_tags = { Environment = "prod", ManagedBy = "terraform" }

# ---------------------------------------------------------------------------
# Basic — application data storage with containers
# ---------------------------------------------------------------------------

storage_accounts = {
  app-data = {
    resource_group_name  = "rg-mycompany-app-prod"
    location             = "eastus"
    storage_account_name = "stmycompanyappprod"
    versioning_enabled   = true

    containers = {
      uploads = {
        access_type = "private"
      }
      exports = {
        access_type = "private"
      }
    }

    tags = {
      Purpose = "application-data"
    }
  }
}

