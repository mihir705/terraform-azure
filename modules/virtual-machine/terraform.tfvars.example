# Virtual Machine module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/virtual-machine/README.md

# ---------------------------------------------------------------------------
# Private app server with SSH key and cloud-init
# ---------------------------------------------------------------------------

virtual_machines = {
  app = {
    name                = "my-company-app-prod"
    resource_group_name = "my-company-rg-prod"
    location            = "eastus"
    size                = "Standard_B2s"
    admin_username      = "azureuser"
    vnet_key            = "main"
    subnet_key          = "private-a"
    nsg_key             = "app"

    source_image_reference = {
      publisher = "Canonical"
      offer     = "0001-com-ubuntu-server-jammy"
      sku       = "22_04-lts-gen2"
      version   = "latest"
    }

    admin_ssh_key = {
      username   = "azureuser"
      public_key = "ssh-rsa AAAAB3NzaC1yc2E... user@host"
    }

    os_disk = {
      disk_size_gb = 64
    }

    custom_data = <<-EOF
      #!/bin/bash
      apt-get update && apt-get install -y nginx
    EOF

    tags = {
      Purpose = "application-server"
    }
  }
}

