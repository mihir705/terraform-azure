# Key Vault Secret module — terraform.tfvars example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/key-vault-secret/README.md
#
# Required in terraform.tfvars (once per environment):
#   location     = "eastus"
#   default_tags = { Environment = "prod", ManagedBy = "terraform" }
#
# Never commit real secret values to version control.

# ---------------------------------------------------------------------------
# Basic — empty secret shell (value set outside Terraform)
# ---------------------------------------------------------------------------

key_vault_secrets = {
  app-config = {
    resource_group_name = "rg-mycompany-app-prod"
    location            = "eastus"
    name                = "app-config"

    vault_key = {
      name = "kv-mycompany-app-prod"
    }

    tags = {
      Purpose = "app-config"
    }
  }
}

