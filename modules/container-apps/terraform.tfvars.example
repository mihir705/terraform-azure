# Container Apps module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/container-apps/README.md
#
# Environment variable name: container_apps (not container_app_environments)

# ---------------------------------------------------------------------------
# Consumption environment with public HTTP ingress (no VNet subnet required)
# ---------------------------------------------------------------------------

container_apps = {
  platform = {
    name               = "my-company-cae-prod"
    resource_group_key = "app"

    container_apps = {
      hello = {
        ingress = {
          external_enabled = true
          target_port      = 80
          transport        = "auto"
        }

        template = {
          min_replicas = 1
          max_replicas = 10

          containers = {
            hello = {
              name   = "hello"
              image  = "mcr.microsoft.com/k8se/quickstart:latest"
              cpu    = 0.25
              memory = "0.5Gi"
            }
          }

          scale_rules = [
            {
              name = "http-scaling"
              http = {
                concurrent_requests = "100"
              }
            }
          ]
        }
      }
    }

    tags = {
      Purpose = "platform"
    }
  }
}

