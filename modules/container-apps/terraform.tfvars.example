# Container Apps module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/container-apps/README.md

# ---------------------------------------------------------------------------
# Container Apps Environment with HTTP-scaled API
# ---------------------------------------------------------------------------

container_app_environments = {
  platform = {
    name                = "my-company-cae-prod"
    resource_group_name = "my-company-rg-prod"
    location            = "eastus"
    vnet_key            = "main"
    subnet_key          = "container-apps"

    container_apps = {
      api = {
        ingress = {
          external_enabled = true
          target_port      = 8080
          transport        = "auto"
        }

        template = {
          min_replicas = 1
          max_replicas = 10

          containers = {
            api = {
              name   = "api"
              image  = "mycompanyprod.azurecr.io/api:latest"
              cpu    = 0.5
              memory = "1Gi"
              env = [
                { name = "ENV", value = "prod" }
              ]
            }
          }

          scale_rules = [
            {
              name = "http-scaling"
              http = {
                concurrent_requests = "100"
              }
            }
          ]
        }

        tags = { Purpose = "api" }
      }
    }

    tags = {
      Purpose = "platform"
    }
  }
}

