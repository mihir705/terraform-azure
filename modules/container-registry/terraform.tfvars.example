# Container Registry module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/container-registry/README.md

# ---------------------------------------------------------------------------
# Standard registry with managed identity (admin disabled)
# ---------------------------------------------------------------------------

container_registries = {
  app = {
    name                = "mycompanyprod"
    resource_group_name = "my-company-rg-prod"
    location            = "eastus"
    sku                 = "Standard"
    admin_enabled       = false

    identity = {
      type = "SystemAssigned"
    }

    tags = {
      Purpose = "application-images"
    }
  }
}

